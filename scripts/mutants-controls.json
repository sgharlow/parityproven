[
  { "name": "text value not changed", "from": "return v.length ? `s:${v.slice(0, -1)}${v.endsWith(\"X\") ? \"Y\" : \"X\"}` : \"s:X\";", "to": "return v.length ? `s:${v}` : \"s:X\";" },
  { "name": "text value made longer (would not fit the column)", "from": "return v.length ? `s:${v.slice(0, -1)}${v.endsWith(\"X\") ? \"Y\" : \"X\"}` : \"s:X\";", "to": "return v.length ? `s:${v}~corrupted` : \"s:X\";" },
