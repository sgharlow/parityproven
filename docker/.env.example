# Copy this file to .env and fill in the values before running docker compose.
# Never commit .env — it is gitignored.

# SQL Server SA password (must meet SQL Server complexity requirements: 8+ chars, upper, lower, digit, special)
MSSQL_SA_PASSWORD=

# PostgreSQL superuser password
PG_PASSWORD=

# Optional: host ports (defaults 1433 and 5432). Set both here to run a second stack beside an existing one,
# together with COMPOSE_PROJECT_NAME (the harness finds the SQL Server container as <project>-mssql-1).
# MSSQL_PORT=1433
# PG_PORT=5432
# COMPOSE_PROJECT_NAME=docker
