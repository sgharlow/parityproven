{
  "name": "parityproven",
  "version": "0.1.0",
  "description": "Proves T-SQL to PL/pgSQL conversions with property-based equivalence testing and migration receipts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:ci": "tsc && node dist/cli/receipts.js",
    "verify": "node dist/cli/convert.js --all",
    "inventory": "node dist/cli/inventory.js",
    "convert": "node dist/cli/convert.js",
    "predictions:validate": "node dist/cli/predictions.js validate",
    "predictions:score": "node dist/cli/predictions.js score",
    "receipts:build": "node dist/cli/receipts.js",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-check": "3.22.0",
    "mssql": "11.0.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/mssql": "9.1.5",
    "@types/node": "22.15.0",
    "@types/pg": "8.11.10",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
